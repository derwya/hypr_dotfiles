/**
 * Rofi launcher: Tokyo Night, frosted glass (Hyprland blurs the "rofi" layer).
 * Used by SUPER+SPACE (apps), SUPER+R (run), SUPER+F (files), SUPER+W (windows).
 */

* {
    bg:          rgba(26, 27, 38, 0.90);
    bg-solid:    #1a1b26;
    surface:     rgba(36, 40, 59, 0.85);
    hover:       rgba(122, 162, 247, 0.16);
    border-col:  #7aa2f7;
    blue:        #7aa2f7;
    purple:      #bb9af7;
    cyan:        #7dcfff;
    fg:          #c0caf5;
    fg-dim:      #a9b1d6;
    grey:        #565f89;

    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 700px;
    border: 2px;
    border-radius: 16px;
    border-color: @border-col;
    background-color: @bg;
}

mainbox {
    padding: 16px;
    spacing: 12px;
    children: [ inputbar, message, listview, mode-switcher ];
}

/* ── Search ─────────────────────────────────────────── */
inputbar {
    padding: 12px 14px;
    spacing: 12px;
    border-radius: 12px;
    background-color: @surface;
    children: [ prompt, entry ];
}

prompt {
    text-color: @blue;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search…";
    placeholder-color: @grey;
    cursor: text;
}

message {
    padding: 10px 12px;
    border-radius: 10px;
    background-color: @surface;
}

textbox {
    text-color: @fg-dim;
}

/* ── Results ────────────────────────────────────────── */
listview {
    lines: 7;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px;
    cycle: true;
}

element {
    padding: 9px 12px;
    spacing: 14px;
    border-radius: 10px;
    border: 0 0 0 3px;
    border-color: transparent;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @hover;
    border-color: @blue;
    text-color: @blue;
}

element normal.active,
element alternate.active {
    text-color: @cyan;
}

element selected.active {
    background-color: @hover;
    border-color: @cyan;
    text-color: @cyan;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: #f7768e;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: bold #bb9af7;
}

/* ── Mode pills (Apps / Run / Files / Window / Calc) ── */
mode-switcher {
    spacing: 8px;
}

button {
    padding: 8px;
    border-radius: 10px;
    background-color: @surface;
    text-color: @grey;
    cursor: pointer;
}

button selected {
    background-color: @hover;
    text-color: @blue;
}
