{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 8,
  "on-sigusr1": "hide",
  "on-sigusr2": "show",
  "ipc": true,
  "modules-left": [
    "custom/launcher",
    "cpu",
    "temperature",
    "memory",
    "custom/gpu"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/updates",
    "hyprland/language",
    "wireplumber",
    "bluetooth",
    "network",
    "tray",
    "custom/notification"
  ],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "cpu": {
    "interval": 3,
    "format": "󰻠 {usage}%",
    "tooltip": true,
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "kitty --class tui-popup -e btop"
  },
  "temperature": {
    "//": "CPU (k10temp Tctl); stable PCI path so it survives hwmon renumbering",
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 3,
    "format": "{temperatureC}°",
    "warning-threshold": 75,
    "critical-threshold": 85,
    "format-critical": "󰸁 {temperatureC}°",
    "tooltip-format": "CPU temperature: {temperatureC}°C",
    "on-click": "kitty --class tui-popup -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}G",
    "tooltip": true,
    "tooltip-format": "RAM   {used:0.1f} / {total:0.1f} GB ({percentage}%)\nSwap  {swapUsed:0.1f} / {swapTotal:0.1f} GB",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "kitty --class tui-popup -e btop"
  },
  "custom/gpu": {
    "format": "󰢮 {}",
    "return-type": "json",
    "interval": 3,
    "exec": "~/.config/waybar/scripts/gpu-usage.sh",
    "tooltip": true,
    "on-click": "nvidia-settings"
  },
  "clock": {
    "interval": 1,
    "format": "{0:%H:%M}  <span alpha='55%'>{0:%a %d %b}</span>",
    "tooltip": false,
    "on-click": "qs -c widgets ipc call widgets toggle calendar"
  },
  "custom/updates": {
    "format": "󰏔 {}",
    "interval": 3600,
    "//": "prints nothing (module hidden) when there are no updates",
    "exec": "n=$(checkupdates 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && echo \"$n\" || true",
    "on-click": "kitty --class tui-popup -e yay",
    "tooltip": true,
    "tooltip-format": "{} updates available"
  },
  "hyprland/language": {
    "format": "󰌌 {}",
    "format-en": "US",
    "format-ua": "UA"
  },
  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": [
      "󰕿",
      "󰖀",
      "󰕾"
    ],
    "on-click": "qs -c widgets ipc call widgets toggle audio",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- --limit 1.0",
    "max-volume": 100,
    "tooltip": true,
    "tooltip-format": "{node_name}: {volume}%"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "on-click": "qs -c widgets ipc call widgets toggle bluetooth",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "format-disabled": "󰤭",
    "interval": 3,
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n󰤨 {essid}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\n󰕒 {bandwidthUpBytes}   󰇚 {bandwidthDownBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "qs -c widgets ipc call widgets toggle network",
    "on-click-right": "nm-connection-editor"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": false
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󱅫",
      "dnd-none": "󰂛",
      "inhibited-notification": "󱅫",
      "inhibited-none": "󰂚",
      "dnd-inhibited-notification": "󱅫",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  }
}
